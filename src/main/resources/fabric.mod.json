{
  "schemaVersion": 1,
  "id": "beyonddimensions",
  "version": "${version}",
  "name": "Beyond Dimensions",
  "description": "A mod provided some utilities.",
  "authors": [
    "Frostbite"
  ],
  "icon": "assets/beyonddimensions/icon.png",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.wintercogs.beyonddimensions.BeyondDimensions"
    ],
    "client": [
      "com.wintercogs.beyonddimensions.BeyondDimensionsClient"
    ],
    "emi": [
      "com.wintercogs.beyonddimensions.integration.module.emi.BDEMIPlugin"
